#!/usr/bin/env fish
set -lx log_registry Cybw

# corrige cwd pour les CGI
set -gx CYBW_BAK_CWD (pwd)
cd (status dirname)/..

# restaure cwd
function on_sigint --on-signal SIGINT; exit 130; end
function on_sigterm --on-signal SIGTERM; exit 143; end
function on_exit --on-event fish_exit; cd $CYBW_BAK_CWD; end

set -l script cgi/$argv[1].fish

test -f "$script"
or exit (llerr -e2 "commande inconnu: $(llcode $argv[1])")

$script $argv[2..-1]
